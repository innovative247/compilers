<Project Sdk="Microsoft.NET.Sdk">

  <!-- ibcp is the alias for bcp_data: the same Program.cs, built under its own name. -->
  <ItemGroup>
    <ProjectReference Include="..\ibsCompiler\ibsCompiler.csproj" />
    <Compile Include="..\bcp_data\Program.cs" Link="Program.cs" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
